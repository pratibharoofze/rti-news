{
  "expo": {
    "name": "rti-news",
    "slug": "rti-news",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roofze.rtinews",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.roofze.rtinews"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow RTI News to save certificates to your gallery.",
          "savePhotosPermission": "Allow RTI News to save certificates to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "790ebc30-229b-4861-8f93-0838f09ff045"
      }
    },
    "owner": "roofze",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/790ebc30-229b-4861-8f93-0838f09ff045"
    }
  }
}
